# Copy this file to .env for local development: cp .env.example .env
# On Vercel, add the same keys under Project → Settings → Environment Variables.

# Public address of the site, used for SEO, the sitemap and share previews.
# Leave unset to use https://aqsashakoor.vercel.app
SITE_URL=https://aqsashakoor.vercel.app

# Contact form (https://resend.com → API Keys). Without it, messages are
# printed to the terminal in development and the form shows an error in production.
RESEND_API_KEY=

# Where contact messages are delivered. Defaults to the email in src/data/site.ts.
CONTACT_TO_EMAIL=aqsashakoor21@gmail.com

# Sender address. Keep the default until you verify your own domain in Resend,
# then use something like: Aqsa Shakoor <hello@aqsashakoor.com>
CONTACT_FROM_EMAIL=Portfolio contact form <onboarding@resend.dev>
